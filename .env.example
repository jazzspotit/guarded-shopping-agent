# Copy to .env.local (never commit real values)

# --- PayPal (sandbox) — developer.paypal.com → Apps & Credentials → Sandbox ---
# Use an app linked to a US sandbox BUSINESS account (non-US merchants can fail with UNSUPPORTED_PAYEE_CURRENCY)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: set after registering the webhook so signatures are verified
PAYPAL_WEBHOOK_ID=

# --- Channel3 product search — trychannel3.com/developers ---
CHANNEL3_API_KEY=

# --- LLM: set ONE key; AI_PROVIDER/AI_MODEL are optional overrides ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# AI_PROVIDER=anthropic   # anthropic | openai | google
# AI_MODEL=claude-sonnet-4-5

# Public URL (only needed if auto-detection is wrong, e.g. behind a custom proxy)
# APP_BASE_URL=https://your-app.onrender.com
